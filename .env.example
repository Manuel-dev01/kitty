# Copy to .env (gitignored). Test/sandbox credentials ONLY. This repo is public.

# Neon via the Vercel Marketplace. `vercel env pull .env.local` fills these. The unpooled URL is used for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Optional: a throwaway Postgres for the ledger's DB tests (each test uses its own schema). Never production.
TEST_DATABASE_URL=

# Paystack (NG), test mode. Must start with sk_test_
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Safaricom Daraja (KE), sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_B2C_INITIATOR=testapi
DARAJA_B2C_SECURITY_CREDENTIAL=
DARAJA_B2C_SHORTCODE=

# MTN MoMo (UG + GH), sandbox. Created by scripts/momo-provision.mjs
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENV=sandbox
MOMO_COLLECTION_SUBSCRIPTION_KEY=
MOMO_COLLECTION_API_USER=
MOMO_COLLECTION_API_KEY=
MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MOMO_DISBURSEMENT_API_USER=
MOMO_DISBURSEMENT_API_KEY=

# Agent
# DeepSeek (OpenAI-compatible chat completions + tool calling)
DEEPSEEK_API_KEY=
KITTY_AGENT_MODEL=deepseek-v4-pro

# WhatsApp Cloud API test number (stretch)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# App
PUBLIC_BASE_URL=
KITTY_REPLAY=0
# Shared secret carried in Daraja/MoMo callback URLs (they cannot sign webhooks)
KITTY_WEBHOOK_SECRET=
